{%- macro icon(kind) -%}
<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">{{ ICONS[kind] | safe }}</svg>
{%- endmacro -%}
<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.name }} · {{ r.role_title }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<main class="page">
<div class="content" id="content">
  <div class="topbar"></div>
  <header class="head{% if r.photo %} has-photo{% endif %}">
    <div class="who">
      <h1>{{ r.name }}</h1>
      {% if r.contact %}
      <ul class="contact">
        {% for c in r.contact %}<li>{{ icon(c.kind) }}{% if c.href %}<a href="{{ c.href }}">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if r.headline %}<p class="headline">{{ icon("target") }}{{ r.headline }}</p>{% endif %}
    </div>
    {% if r.photo %}<div class="photo"><img src="{{ r.photo }}" alt="证件照"></div>{% endif %}
  </header>
  {% if r.summary %}<p class="summary">{{ r.summary | rich }}</p>{% endif %}

  {% if r.education %}
  <section><h2>教育背景</h2>
    {% for e in r.education %}
    <div class="entry">
      <div class="line"><strong class="org">{{ e.school }}{% if e.major %} · {{ e.major }}{% endif %}（{{ e.degree }}）</strong><span class="date">{{ e.period }}</span></div>
      {% for d in e.details %}<p class="detail">{{ d | rich }}</p>{% endfor %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if r.experience %}
  <section><h2>实习经历</h2>
    {% for x in r.experience %}
    <div class="entry">
      <div class="line"><strong class="org">{{ x.org }} · {{ x.title }}</strong><span class="date">{{ x.period }}</span></div>
      {% if x.summary %}<p class="detail">{{ x.summary | rich }}</p>{% endif %}
      <div class="items">{% for p in x.projects %}{% set n = loop.index %}{% include "item.html.j2" %}{% endfor %}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if r.projects %}
  <section><h2>项目经历</h2>
    <div class="items">{% for p in r.projects %}{% set n = loop.index %}{% include "item.html.j2" %}{% endfor %}</div>
  </section>
  {% endif %}

  {% if r.publications %}
  <section><h2>科研成果</h2>
    {% for p in r.publications %}<p class="pub"><span class="badge">{{ p.status }}</span>{{ p.title }}{% if p.venue %}<span class="venue"> · {{ p.venue }}</span>{% endif %}</p>{% endfor %}
  </section>
  {% endif %}

  {% if r.skills %}
  <section><h2>专业技能</h2>
    <div class="skills">{% for s in r.skills %}<p><strong>{{ s.group }}</strong><span>{{ s.items | rich }}</span></p>{% endfor %}</div>
  </section>
  {% endif %}

  {% if r.awards %}
  <section><h2>荣誉奖项</h2>
    <ul class="awards">{% for a in r.awards %}<li><span class="date">{{ a.year }}</span><span>{{ a.name }}{% if a.level %} <strong>{{ a.level }}</strong>{% endif %}</span></li>{% endfor %}</ul>
  </section>
  {% endif %}
</div>
</main>
<script>
/* 单页自适应：在 [MIN, MAX] 内二分查找能放进一页 A4 的最大字号，所有尺寸都随 --fs 缩放。
   结果写在 <html data-fs data-fill>，渲染器据此提示"内容偏少 / 放不下"。 */
(function () {
  var MIN = 11.5, MAX = 14.5, root = document.documentElement, page = document.querySelector(".page"),
      box = document.getElementById("content");
  /* 内容底部到页面顶部的距离，对比 A4 高度减下边距（不用 clientHeight：溢出时页面会被撑高；
     顶部色条用负外边距贴住页顶，所以从页面顶部量，而不是从内容盒子顶部量） */
  function avail() { return 297 * 96 / 25.4 - parseFloat(getComputedStyle(page).paddingBottom) - 1; }
  function used() { return box.getBoundingClientRect().bottom - page.getBoundingClientRect().top; }
  function fits(fs) { root.style.setProperty("--fs", fs + "px"); return used() <= avail(); }
  if (!page || !box || window.matchMedia("(max-width: 700px)").matches) return;
  var lo = MIN, hi = MAX;
  if (fits(hi)) lo = hi;
  else if (!fits(lo)) hi = lo;
  else for (var i = 0; i < 12; i++) { var mid = (lo + hi) / 2; if (fits(mid)) lo = mid; else hi = mid; }
  fits(lo);
  root.dataset.fs = lo.toFixed(2);
  root.dataset.fill = (used() / avail()).toFixed(3);
})();
</script>
</body>
</html>
